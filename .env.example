# ==========================================
# LinkTrack Environment Configuration
# ==========================================

# Server Port
PORT=8080

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/linktrack
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=linktrack

# JWT Security
# Ensure this is a secure 256-bit or 512-bit hex/base64 encoded key in production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970337336763979244226452948404D6351
# Token Expiration (86400000 ms = 24 hours)
JWT_EXPIRATION=86400000

# Redis Cache (Optional - Application falls back seamlessly if disabled or unreachable)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLED=true

# Application URLs
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Frontend Environment Variable
VITE_API_URL=http://localhost:8080
